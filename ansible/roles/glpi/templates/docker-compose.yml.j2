name: glpi

services:
  glpi:
    image: "glpi/glpi:latest"
    restart: "unless-stopped"
    volumes:
      # Using a named volume avoids permission issues on host (automatically managed by Docker)
      - glpi_data:/var/glpi
      # For GLPI 10.x, uncomment the following line to create a volume for plugins fetched from the marketplace.
      # - "./storage/glpi_marketplace:/var/www/glpi/marketplace/:rw"
    environment:
      GLPI_DB_HOST: {{ GLPI_DB_HOST }}
      GLPI_DB_PORT: {{ GLPI_DB_PORT }}
      GLPI_DB_NAME: {{ GLPI_DB_NAME }}
      GLPI_DB_USER: {{ GLPI_DB_USER }}
      GLPI_DB_PASSWORD: {{ VAULT_GLPI_DB_PASSWORD }}
    depends_on:
      - db
    ports:
      - "{{ glpi_host_port }}:80"
    networks:
      - {{ docker_network_name }}

  db:
    image: "mysql"
    restart: "unless-stopped"
    volumes:
      - db_data:/var/lib/mysql
    environment:
      MYSQL_RANDOM_ROOT_PASSWORD: "yes"
      MYSQL_DATABASE: {{ GLPI_DB_NAME }}
      MYSQL_USER: {{ GLPI_DB_USER }}
      MYSQL_PASSWORD: {{ VAULT_GLPI_DB_PASSWORD }}
    networks:
      - {{ docker_network_name }}

volumes:
  glpi_data:
  db_data:

networks:
  {{ docker_network_name }}:
    external: true
